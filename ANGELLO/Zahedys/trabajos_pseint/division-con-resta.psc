Algoritmo sin_ti
		Escribir " digite el numero que quiere que sea el dividendo "
		leer a
		escribir " digie el numero que quiere que sea el divisor "
		leer b
		v = 0
		mientras a >= b hacer
			a = a - b
			v = v + 1
		FinMientras
		Escribir  "el cociente es " v
		escribir "el resto es " a
FinAlgoritmo